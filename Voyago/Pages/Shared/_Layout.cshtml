<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Voyago, plataforma de viajes de lujo y concierge VIP." />
    <title>@ViewData["Title"] | Voyago</title>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="vy-skip-link" href="#main-content">Saltar al contenido</a>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark vy-navbar" aria-label="Navegación principal">
            <div class="container">
                <a class="navbar-brand vy-logo" asp-area="" asp-page="/Index" aria-label="Voyago, inicio">VOYAGO</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Abrir navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav me-auto mb-3 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Index">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link disabled" aria-disabled="true">Destinos</a></li>
                        <li class="nav-item"><a class="nav-link disabled" aria-disabled="true">Paquetes</a></li>
                        <li class="nav-item"><a class="nav-link disabled" aria-disabled="true">Hoteles</a></li>
                        <li class="nav-item"><a class="nav-link disabled" aria-disabled="true">Vuelos</a></li>
                        @if (User.IsInRole("Administrator"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-page="/Index">Administración</a></li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <main id="main-content" tabindex="-1">
        @RenderBody()
    </main>
    <footer class="vy-footer py-4 mt-auto">
        <div class="container d-flex flex-column flex-md-row justify-content-between gap-2">
            <span>&copy; @DateTime.UtcNow.Year Voyago</span>
            <a asp-area="" asp-page="/Privacy">Privacidad</a>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script type="module" src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
