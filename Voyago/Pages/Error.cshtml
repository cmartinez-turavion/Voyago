@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}
<section class="container py-5" role="alert">
    <p class="vy-eyebrow">No pudimos completar la solicitud</p>
    <h1>Ha ocurrido un error.</h1>
    <p class="text-secondary-emphasis">Intenta nuevamente. Si el problema continúa, informa el identificador de la solicitud.</p>
    @if (Model.ShowRequestId)
    {
        <p><strong>Identificador:</strong> <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-primary" asp-page="/Index">Volver al inicio</a>
</section>
