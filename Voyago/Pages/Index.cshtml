@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}
<section class="vy-hero py-5" aria-labelledby="hero-title">
    <div class="container py-5">
        <p class="vy-eyebrow mb-3">Luxury Travel &amp; VIP Concierge</p>
        <h1 id="hero-title" class="display-3 mb-4">Viajes extraordinarios, diseñados a tu medida.</h1>
        <p class="lead text-secondary-emphasis col-lg-7 mb-4">Voyago será tu plataforma para descubrir experiencias exclusivas y planificar cada detalle con atención personalizada.</p>
        <a class="btn btn-primary btn-lg" asp-page="/Index">Comenzar a explorar</a>
    </div>
</section>
<section class="container py-5" aria-labelledby="foundation-title">
    <div class="vy-card p-4 p-lg-5">
        <p class="vy-eyebrow">Fundación técnica</p>
        <h2 id="foundation-title" class="h1">La experiencia Voyago comienza aquí</h2>
        <p class="mb-0 text-secondary-emphasis">La plataforma base está preparada con identidad, autorización y una interfaz adaptable.</p>
    </div>
</section>
